<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.indywiseguy.bgg-collection-postgres-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/indywiseguy/New-BGG-Python/.venv/bin/python</string>
        <string>/Users/indywiseguy/New-BGG-Python/scheduled_sync_collection.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/indywiseguy/New-BGG-Python</string>

    <!-- Once daily at 6am, machine's local timezone. Adjust to taste — this
         run does a real headed-browser BGG login, so a visible Chromium
         window will pop up briefly. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/indywiseguy/New-BGG-Python/data/collection_sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/indywiseguy/New-BGG-Python/data/collection_sync.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
